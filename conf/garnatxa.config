/*
  -------------------------------------------------
  miRdeX-nf garnatxa config file
  -------------------------------------------------
  Configuration file specific for the execution of the miRdeX-nf
  workflow on Garnatxa, the High Performance Computing (HPC) cluster
  located at the Data Center of the Institute for Integrative Systems
  Biology (I2SysBio).
*/


// Definition of the slurm executor.
process {
  executor = 'slurm'
}

// Definition of the number of jobs submited at a given time.
executor {
  queueSize = 100
}

// Garnatxa specific computing max resource levels (for this pipeline)
params {
  max_memory = 100.GB
  max_cpus = 30
  max_time = 30.d
}

process {

  // Memory and time increases with the number of retrys
  // Trimming (default)
  cpus    = { check_max( 2      * task.attempt, 'cpus'      ) }
  memory  = { check_max( 2.GB   * task.attempt, 'memory'    ) }
  time    = { check_max( 30.m   * task.attempt, 'time'      ) }

  errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries = 5 // 2 attempts
  maxErrors = '-1' // no limit

  // Process-specific resource requirements
  withName:CUSTOM_SRATOOLSNCBISETTINGS {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 5.m     * task.attempt, 'time'    ) }
  }
  withName:SRATOOLS_PREFETCH {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 5.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 6.h     * task.attempt, 'time'    ) }
  }
  withName:SRATOOLS_FASTERQDUMP {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 5.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 6.h     * task.attempt, 'time'    ) }
  }
  withName:FASTP {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 6.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 4.h     * task.attempt, 'time'    ) }
  }
  withName:FASTQC {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.h     * task.attempt, 'time'    ) }
  }
  withName:MULTIQC {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.h     * task.attempt, 'time'    ) }
  }
  withName:SEQKIT_FQ2FA {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.d     * task.attempt, 'time'    ) }
  }
  withName:SEQKIT_RMDUP {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.d     * task.attempt, 'time'    ) }
  }
  withName:BLAST_MAKEBLASTDB {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 5.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 3.h     * task.attempt, 'time'    ) }
  }
  withName:BLAST_BLASTN {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.h     * task.attempt, 'time'    ) }
  }
  withName:ADD_COUNTS_TO_ISOMIRS_DF {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 20.m    * task.attempt, 'time'    ) }
  }
  withName:FILTER_ISOMIRS_BY_ABUNDANCE {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.h     * task.attempt, 'time'    ) }
  }
  withName:ADD_SEQUENCES_BLAST {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 20.m    * task.attempt, 'time'    ) }
  }
  withName:ANNOTATE_DEA_RESULTS {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:BOWTIE_BUILD {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 10      * task.attempt, 'cpus'    ) }
    memory = { check_max( 25.GB   * task.attempt, 'memory'  ) }
    time   = { check_max( 3.h     * task.attempt, 'time'    ) }
  }
  withName:BOWTIE_ALIGN {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 5.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.h     * task.attempt, 'time'    ) }
  
    // Custom errorStrategy due to a particular bowtie error. In addition
    // to all  possible exitcodes  included in the  general errorStrategy, the
    // possibility of an exitcode 1 together with the message “Some of the step
    // tasks have been OOM  Killed” is also included. Apparently due to a memory
    // problem with bowtie, slurm  kills the process too  fast without a
    // clear out-of-memory error like 125 or 137 and writes to the .command.log
    // the mentioned sentence. To avoid repeating the process due to exitcode 1
    // which is very  general, we have designed this custom errorStrategy for
    // this process.
    errorStrategy = {
      def oom = false
      try {
        def logFile = new File("${task.workDir}/.command.log")
        if (logFile.exists()) {
          oom = (task.exitStatus == 1) && logFile.text.contains('Some of the step tasks have been OOM Killed')
        }
      } catch (all) {
        oom = false
      }

      return oom || task.exitStatus in [101, 104, 125, 126] + (130..145) + 255 ? 'retry' : 'finish'
    }
  }
  withName:BUILD_MIRNA_EVENT_MATRIX {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m    * task.attempt, 'time'    ) }
  }
  withName:COLLAPSE_DB {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m    * task.attempt, 'time'    ) }
  }
  withName:CONCAT_TSV {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m    * task.attempt, 'time'    ) }
  }
  withName:CONCAT_FILTER_UNIQUE_GFF3 {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:COUNTS {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:COUNTS_MATRIX {
    clusterOptions = "--qos=long"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 20.GB   * task.attempt, 'memory'  ) }
    time   = { check_max( 15.d    * task.attempt, 'time'    ) }
  }
  withName:COUNTS_VALIDATION {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 6.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:DIFFEXPANALYSIS {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 20.GB   * task.attempt, 'memory'  ) }
    time   = { check_max( 12.h    * task.attempt, 'time'    ) }
  }
  withName:DNA_RNA_CONVERTER {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 20.m    * task.attempt, 'time'    ) }
  }
  withName:DOWNLOAD_DB {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 40.m    * task.attempt, 'time'    ) }
  }
  withName:FILTER_TSV_BY_FASTA {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 3.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:ISOMIRS_MIRNA_CLASSIFICATION {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:ISOMIRS_PRECURSOR_CLASSIFICATION {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:LIBRARIES_VALIDATION {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 1.d     * task.attempt, 'time'    ) }
  }
  withName:MERGE_AND_FILTER_MATURE_PRECURSOR_BLAST {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 20.m    * task.attempt, 'time'    ) }
  }
  withName:RPM {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 2.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 30.m    * task.attempt, 'time'    ) }
  }
  withName:SPLIT_DB_BY_SPECIES {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m    * task.attempt, 'time'    ) }
  }
  withName:TSV_TO_FASTA {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m     * task.attempt, 'time'    ) }
  }
  withName:RENAME_FILE_BY_ID {
    clusterOptions = "--qos=short"
    cpus   = { check_max( 2       * task.attempt, 'cpus'    ) }
    memory = { check_max( 1.GB    * task.attempt, 'memory'  ) }
    time   = { check_max( 10.m     * task.attempt, 'time'    ) }
  }
}

// Function to ensure that resource requirements don't go beyond a maximum limit
def check_max(obj, type) {
  if (type == 'memory') {
    try {
      if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
        return params.max_memory as nextflow.util.MemoryUnit
      else
        return obj
    } catch (all) {
      println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
      return obj
    }
  } else if (type == 'time') {
    try {
      if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
        return params.max_time as nextflow.util.Duration
      else
        return obj
    } catch (all) {
      println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
      return obj
    }
  } else if (type == 'cpus') {
    try {
      return Math.min( obj, params.max_cpus as int )
    } catch (all) {
      println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
      return obj
    }
  }
}
