/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
----------------------------------------------------------------------------------------
*/

process {
  withName: 'FASTQC' {
    ext.args = { params.extra_fastqc_args ?: '' }
    memory = '4GB' // Supongo que habra que eliminar esto cuando usemos la memoria que corresponda. DEBE TENER UNA MEMORIA ASIGNADA O DA ERROR.
    publishDir = [
      path: { "${params.outdir}/01-Libraries/00-FastQC/${meta.type}/01-Fastqc/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: '*.{zip,html}'
    ]
  }
  withName: 'MULTIQC' {
    ext.args = { params.extra_multiqc_args ?: '' }
    publishDir = [
      path: { "${params.outdir}/01-Libraries/00-FastQC/${meta.type}/02-Multiqc/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: '*.html'
    ]
  }
  withName: 'FASTP' {
    ext.args = {
      params.trimming_custom_args ?:
      "--cut_right " +
      "--cut_right_window_size 4 " +
      "--cut_right_mean_quality 20 " +
      "--cut_front " +
      "--cut_front_window_size 1 " +
      "--cut_front_mean_quality 3 " +
      "--length_required ${params.trimming_min_len} " +
      "--trim_poly_x " +
      "--poly_x_min_len 10 " +
      "--length_limit ${params.trimming_max_len} " +
      "--n_base_limit 0"
    }
    publishDir = [
      path: { "${params.outdir}/01-Libraries/02-Trimmed/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: '*.fastp.fastq.gz'
    ]
  }
  withName: 'BOWTIE_ALIGN_DB' {
    ext.ref = 'database'
    ext.args = { params.bowtie_filt_db_ext_args ?: '-v 0' }
    cpus = 2
    publishDir = [
      [
        path: { "${params.outdir}/01-Libraries/03-Filtered_libraries/01-Database/${meta.species.replaceAll(' ', '_')}/${meta.project}/01-Alignment_out"},
        mode: 'copy',
        overwrite: true,
        pattern: '*.out'
      ],
      [
        path: { "${params.outdir}/01-Libraries/03-Filtered_libraries/01-Database/${meta.species.replaceAll(' ', '_')}/${meta.project}/02-Libraries" },
        mode: 'copy',
        overwrite: true,
        pattern: '*fastq.gz'
      ]
    ]
  }
  withName: 'BOWTIE_ALIGN_GENOME' {
    ext.ref = 'genome'
    ext.args = { params.bowtie_filt_genome_ext_args ?: '-v 0' }
    cpus = 2
    publishDir = [
      [
        path: { "${params.outdir}/01-Libraries/03-Filtered_libraries/02-Genome/${meta.species.replaceAll(' ', '_')}/${meta.project}/01-Alignment_out"},
        mode: 'copy',
        overwrite: true,
        pattern: '*.out'
      ],
      [
        path: { "${params.outdir}/01-Libraries/03-Filtered_libraries/02-Genome/${meta.species.replaceAll(' ', '_')}/${meta.project}/02-Libraries" },
        mode: 'copy',
        overwrite: true,
        pattern: '*fastq.gz'
      ]
    ]
  }
  withName: 'COUNTS' {
    publishDir = [
      path: { "${params.outdir}/02-Results/01-Counts_by_sample/01-Raw_counts/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: '*.raw.tsv'
    ]
  }
  withName: 'RPM' {
    publishDir = [
      path: { "${params.outdir}/02-Results/01-Counts_by_sample/01-RPM/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: '*.rpm.tsv'
    ]
  }
  withName: 'COUNTS_MATRIX' {
    publishDir = [
      [
        path: { "${params.outdir}/02-Results/02-Counts_matrix/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.raw.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/02-Counts_matrix/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.rpm.tsv"
      ]
    ]
  }
  withName: 'DIFFEXPANALYSIS' {
    publishDir = [
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*_raw.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*_sig.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.ea_summary.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.dea_summary.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "01-PCA"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "02-SERE_dendrogram"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "03-Mean_vs_variance"
      ],
      [
        path: { "${params.outdir}/02-Results/03-DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.volcano.png"
      ]
    ]
  }
  withName: 'BOWTIE_ALIGN_NONTEMPLATED' {
      ext.args = { params.bowtie_nti_ext_args ?: '-f -v 0' }
  }
  withName: 'DOWNLOAD_DB' {
    publishDir = [
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/miRBase/*_mature.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/miRBase/*_hairpin.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/sRNAanno/*_mature.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/sRNAanno/*_hairpin.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/PmiREN/*_mature.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "01-Mod_databases/PmiREN/*_hairpin.fa"
      ],
      [
        path: { "${params.outdir}/00-Additional_data/01-Databases" },
        mode: 'copy',
        pattern: "species_ids.csv"  
      ]
    ]
  }
  withName: 'SEQKIT_RMDUP' {
    ext.args = '-s -P'
  }
  withName: 'BLAST_MAKEBLASTDB' {
    ext.args = '-dbtype nucl'
  }
  withName: '.*ISOMIRS_IDENTIFICATION:COMPLETE_BLASTN_MATURE:BLAST_BLASTN' {
    ext.args = '-task blastn-short -outfmt 6 -word_size 13 -gapopen 5 -gapextend 2 -strand plus -evalue 0.01'
    publishDir = [
      path: { "${params.outdir}/02-Results/04-Annotation/01-BLAST/01-Mature_miRNA/${meta.species.replaceAll(' ', '_')}/${meta.project}"},
      mode: 'copy',
      overwrite: true,
      pattern: "*.txt"
    ]
  }
  withName: '.*ISOMIRS_IDENTIFICATION:COMPLETE_BLASTN_PRECURSOR:BLAST_BLASTN' {
    ext.args = '-task blastn-short -outfmt 6 -word_size 13 -gapopen 5 -gapextend 2 -strand plus -evalue 0.01'
    publishDir = [
      path: { "${params.outdir}/02-Results/04-Annotation/01-BLAST/01-Precursor_miRNA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: "*.txt"
    ]
  }
  withName: 'MERGE_AND_FILTER_MATURE_PRECURSOR_BLAST' {
    publishDir = [
      path: { "${params.outdir}/02-Results/04-Annotation/01-BLAST/03-Mature_and_precursor/${meta.species.replaceAll(' ', '_')}/${meta.project}"},
      mode: 'copy',
      overwrite: true,
      pattern: "*mpblast.tsv"
    ]
  }
  withName: 'ISOMIRS_MIRNA_CLASSIFICATION' {
    publishDir = [
      path: { "${params.outdir}/02-Results/04-Annotation/02-miRNA_annotation/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
      mode: 'copy',
      overwrite: true,
      pattern: "*.gff3"
    ]
  }
  withName: 'ANNOTATE_DEA_RESULTS' {
    publishDir = [
      [
        path: { "${params.outdir}/02-Results/04-Annotation/03-miRNA_annotation_DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.all.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/04-Annotation/03-miRNA_annotation_DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.unique.tsv"
      ],
      [
        path: { "${params.outdir}/02-Results/04-Annotation/03-miRNA_annotation_DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}" },
        mode: 'copy',
        overwrite: true,
        pattern: "*.boxplot.png"
      ],
      [
        path: { "${params.outdir}/02-Results/04-Annotation/03-miRNA_annotation_DEA/${meta.species.replaceAll(' ', '_')}/${meta.project}"},
        mode: 'copy',
        overwrite: true,
        pattern: "*.summary.tsv"
      ]
    ]
  }
  withName: 'BUILD_MIRNA_EVENT_MATRIX' {
    publishDir = [
      path: { "${params.outdir}/02-Results/05-Presence_absence_matrix" },
      mode: 'copy',
      overwrite: true,
      pattern: "*.tsv"
    ]
  }
}
