nextflow_workflow {

    name "Test Subworkflow ANNOTATION"
    script "../main.nf"
    workflow "ANNOTATION"

    test("Annotation - all databases - min3") {

        when {

            workflow  {
                """
                input[0] = Channel.of([
                    [id:'TEST_1_0', species: 'Glycine max'],
                    file(params.modules_testdata_base_path + 'modules/annotation/TEST_1_0.dea_sig.tsv', checkIfExists: true)
                ])
                input[1] = true
                input[2] = 'Viridiplantae'
                input[3] = true
                input[4] = true
                input[5] = 1
                input[6] = Channel.of(file(params.modules_testdata_base_path + 'modules/annotation/TEST_1.ea_summary.tsv', checkIfExists: true))
                input[7] = 0.7
                input[8] = 3
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert workflow.success }

                // Verify that the necessary output files are generated.
                { assert path(workflow.out.annot.get(0).get(1)) ==~ /.*\.annot_all\.tsv/ }
                { assert path(workflow.out.annotfilt.get(0).get(1)) ==~ /.*\.annot_filt\.tsv/ }
                { assert path(workflow.out.annot_sum.get(0)) ==~ /.*summary\.tsv/ }
                { assert path(workflow.out.annot_sumlen.get(0)) ==~ /.*summary_len\.tsv/ }
                { assert path(workflow.out.fam_annot.get(0).get(1)) ==~ /.*\.fam_annot\.tsv/ }
                { assert path(workflow.out.fam_boxplot.get(0).get(1)) ==~ /.*\.fam_annot_boxplot\.png/ }
                { assert path(workflow.out.fam_sum.get(0)) ==~ /.*\.fam_annot_summary\.tsv/ }

                // Use snapshots to verify
                {
                    assert snapshot(
                        workflow.out.annot,
                        workflow.out.annotfilt,
                        workflow.out.annot_sum,
                        workflow.out.annot_sumlen,
                        workflow.out.fam_annot,
                        workflow.out.fam_boxplot,
                        workflow.out.fam_sum
                    ).match() 
                }
            }
        }
    }
