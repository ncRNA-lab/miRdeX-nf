nextflow_workflow {

    name "Test Workflow PREPARE_MIRNA_DATABASES"
    script "subworkflows/local/prepare_mirna_databases/main.nf"
    workflow "PREPARE_MIRNA_DATABASES"

    test("Prepare miRNA databases (miRNA > PmiREN > sRNAanno) - Species in miRBase") {

        when {

            workflow  {
                """
                input[0] = ['Glycine max']
                input[1] = 'mirbase,pmiren,srnaanno'
                """
            }
        }

        then {
            println(workflow.out.dbs.get(0).mature)
            assertAll{

                // Verify that the process has been successfully executed.
                { assert workflow.success }
                
                // Verify that the necessary output files are generated.
                { assert path(workflow.out.dbs.get(0).mature) ==~  /.*gma_mirbase_mature.collapsed\.fa/ }
                { assert path(workflow.out.dbs.get(0).precursor) ==~  /.*gma_mirbase_precursor\.collapsed.fa/ }

                // Use snapshots to verify
                { assert snapshot(workflow.out.dbs).match() }
            }
        }
    }
    test("Prepare miRNA databases (miRNA > PmiREN > sRNAanno) - Species in sRNAanno") {

        when {

            workflow  {
