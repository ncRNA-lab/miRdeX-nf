nextflow_workflow {

    name "Test Workflow FILTER_NONTEMPLATED_ISOMIRS"
    script "subworkflows/local/filter_nontemplated_isomirs/main.nf"
    workflow "FILTER_NONTEMPLATED_ISOMIRS"

    test("Filter non-templated isomirs") {

        when {

            workflow  {
                """
                input[0] = [
                    [ id: 'file', single_end: true],
                    file(params.modules_testdata_base_path + 'subworkflows/filter_nontemplated_isomirs/file_non_templated.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'subworkflows/filter_nontemplated_isomirs/genome.fna', checkIfExists: true)
                ]
                """
            }
        }

        then {
            println(workflow.out.iso)
            assertAll{

                // Verify that the process has been successfully executed.
                { assert workflow.success }
                
                // Verify that the necessary output files are generated.
                { assert path(workflow.out.iso.get(0)[1]) ==~ /.*filtered\.tsv/ }
                
                // Use snapshots to verify
                { assert snapshot(workflow.out.iso).match() }
            }
        }
    }
}
