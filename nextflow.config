#!/usr/bin/env nextflow

/*
========================================================================================
    miRPlan-nf Config File
========================================================================================
    Main config
----------------------------------------------------------------------------------------
*/

// Main Parameters
params {

  // Input
  input = null
  outdir = null
  email = null
  help = false

  // Input options
  input_fastp = false
  input_validation = false
  input_filtering = false

  // Parameters for QC
  extra_fastqc_args = ''
  extra_multiqc_args = ''

  // Parameters for Trimming
  trimming_adapters = "${projectDir}/assets/illumina_adapters.fa"
  trimming_min_len = 20
  trimming_max_len = 25
  custom_fastp_args = null

  // Parameters for validation
  validation_depth = 500000
  validation_rep = 2

  // Parameters for filtering
  filtering_rnacentral = null // revisar
  filtering_db_mismatches = 0
  filtering_genome_mismatches = 1

  // Parameters for quantification.
  min_counts = 5
  min_samples= 3

  // Parameters for DEA.
  ea_p_value = 0.7 // CAMBIAAAAAAAAAAAAR A 0.05
  dea_alpha = 0.05

  // Parameters for annotation
  annotation_mismatches = 1
  annotation_mirbase = null
  annotation_sRNAanno = null
  annotation_pmiren = null

  // Optional outputs parameters
  counts_project_table = false

  // Skip parameters
  skip_qc = false
  skip_fastqc = false
  skip_multiqc = false
  skip_filt_db = false
  skip_filt_genome = false
  skip_quantification = false
  skip_dea = false
  skip_annotation = false
  
  // Only parameters
  only_preprocessing = false
  
  // From parameters
  from_counts = false

}

validation {
  ignoreParams = ["databases", "databases_local"]
}

// By default, enable Nextflow tracing and save it in the trace directory
// trace {
//   enabled = true
//   overwrite = true
//   file = "${params.tracedir}/execution_trace.txt"
//   fields = "task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,time,memory,%cpu,peak_rss,peak_vmem,rchar,wchar"
// }
// report {
//   enabled = true
//   overwrite = true
//   file = "${params.tracedir}/execution_report.html"
// }
// timeline {
//   enabled = true
//   overwrite = true
//   file = "${params.tracedir}/execution_timeline.html"
// }
// dag {
//   enabled = true
//   overwrite = true
//   file = "${params.tracedir}/pipeline_dag.svg"
// }

plugins {
  id 'nf-schema@2.0.0'
}

// Include other configs
includeConfig 'conf/databases.config'
includeConfig 'conf/modules.config'
//includeConfig 'conf/defaults.config'
includeConfig 'conf/genomes.config'

