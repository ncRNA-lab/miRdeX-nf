nextflow_process {

    name "Test Process DNA_RNA_CONVERTER"
    script "modules/local/dna_rna_converter/main.nf"
    process "DNA_RNA_CONVERTER"

    test("DNA to RNA - .fa extension") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'file_dna' ], 
                    file(params.modules_testdata_base_path + 'modules/dna_rna_converter/file_dna.fa', checkIfExists: true)
                ]
                input[1] = false
                """
            }
        }
        then {
            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.file_conv.get(0)[1]) ==~ /.*\.rna\.fa/ }

                // Use snapshots to verify
                { assert snapshot(process.out.file_conv).match() }
            }
        }
    }
