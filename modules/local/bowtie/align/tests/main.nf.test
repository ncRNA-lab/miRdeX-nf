nextflow_process {

    name "Test Process BOWTIE_ALIGN"
    script "../main.nf"
    process "BOWTIE_ALIGN"

    test("Bowtie alignment") {

        setup {

            run("BOWTIE_BUILD") {
                script "../../../../nf-core/bowtie/build/main.nf"
                process {
                    """
                    input[0] = Channel.of([
                        [id:'reference'],
                        [ file(params.modules_testdata_base_path + 'modules/bowtie/database_test.fasta', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {

            process {
                """
                input[0] = Channel.of(
                    [ [id: 'sample1_test', type: 'database', species: 'Glycine max', project: 'TEST', single_end: true], file(params.modules_testdata_base_path + 'modules/bowtie/sample1_test.fastq.gz', checkIfExists: true) ]
                )
                input[1] = BOWTIE_BUILD.out.index
                input[2] = true
                input[3] = true
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.bam.get(0).get(1)) ==~ /.*\.bam/ }
                { assert path(process.out.log.get(0).get(1)) ==~ /.*\.out/ }
                { assert path(process.out.aligned.get(0).get(1)) ==~ /.*\.aligned\.fastq\.gz/ }
                { assert path(process.out.unaligned.get(0).get(1)) ==~ /.*\.unaligned\.fastq\.gz/ }

                // Use snapshots to verify
                {
                    assert snapshot(
                        process.out.bam,
                        process.out.log,
                        process.out.aligned,
                        process.out.unaligned,
                    ).match() 
                }
            }
        }
    }
}
