// Test for MIRNA_ANNOTATION Process
nextflow_process {

    name "Test Process DOWNLOADDB"
    script "../main.nf"
    process "DOWNLOADDB"

    test("Download Databases - all databases") {

        when {

            process {
                """
                    input[0] = true
                    input[1] = true
                    input[2] = true
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.mirbase_mature.get(0)) ==~ /.*mirbase\/.*mature\.fa/ }
                { assert path(process.out.mirbase_hairpin.get(0)) ==~ /.*mirbase\/.*hairpin\.fa/ }
                { assert path(process.out.mirbase_species.get(0)) ==~ /.*mirbase\/.*mirbase_species\.txt/ }
                { assert path(process.out.srnaanno_all.get(0).get(0)) ==~ /.*srnaanno\/.*miRNA\.gff3/ }
                { assert path(process.out.pmiren_mature.get(0).get(0)) ==~ /.*pmiren\/[^\/]+\/.*_mature\.fa/ }
                { assert path(process.out.pmiren_hairpin.get(0).get(0)) ==~ /.*pmiren\/[^\/]+\/.*_hairpin\.fa/ }

                // Use snapshots to verify
                {
                    assert snapshot(
                        process.out.mirbase_mature,
                        process.out.mirbase_hairpin,
                        process.out.mirbase_species,
                        process.out.srnaanno_all,
                        process.out.pmiren_mature,
                        process.out.pmiren_hairpin
                    ).match() 
                }
            }
        }
    }
    test("Download Databases - miRBase - sRNAanno") {

        when {

            process {
                """
                    input[0] = true
                    input[1] = true
                    input[2] = false
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated. /.*\.species_ids_db\.csv/
                { assert path(process.out.mirbase_mature.get(0)) ==~ /.*mirbase\/.*mature\.fa/ }
                { assert path(process.out.mirbase_hairpin.get(0)) ==~ /.*mirbase\/.*hairpin\.fa/ }
                { assert path(process.out.mirbase_species.get(0)) ==~ /.*mirbase\/.*mirbase_species\.txt/ }
                { assert path(process.out.srnaanno_all.get(0).get(0)) ==~ /.*srnaanno\/.*miRNA\.gff3/ }
                { assert path(process.out.pmiren_mature.get(0)) ==~ /.*pmiren\/empty\/.*EMPTY_pmiren\.mature\.fa/ }
                { assert path(process.out.pmiren_hairpin.get(0)) ==~ /.*pmiren\/empty\/.*EMPTY_pmiren\.hairpin\.fa/ }

                // Use snapshots to verify
                {
                    assert snapshot(
                        process.out.mirbase_mature,
                        process.out.mirbase_hairpin,
                        process.out.mirbase_species,
                        process.out.srnaanno_all,
                        process.out.pmiren_mature,
                        process.out.pmiren_hairpin
                    ).match() 
                }
            }
        }
    }
