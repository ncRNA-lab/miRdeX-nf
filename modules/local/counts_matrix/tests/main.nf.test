nextflow_process {

    name "Test Process COUNTS_MATRIX"
    script "../main.nf"
    process "COUNTS_MATRIX"

    test("Counts matrix - Raw counts - Project matrix") {
        when {

            process {
                """
                input[0] = Channel.of([
                    [id:'TEST', species: 'Arabidopsis thaliana', project: 'TEST'],
                    [
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE1.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE2.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE3.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE4.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE5.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE6.raw.tsv', checkIfExists: true)
                    ],
                    file(params.modules_testdata_base_path + 'modules/test_metadata.tsv', checkIfExists: true),
                    [1]
                ])
                input[1] = 'raw'
                input[2] = true
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }
                // println(process.out.matrix.get(0).get(1).get(0))

                // Verify that the necessary output files are generated.
                { assert path(process.out.matrix.get(0).get(1).get(0)) ==~ /.*\.raw\.tsv/ }

                // Use snapshots to verify
                { assert snapshot(process.out.matrix).match() }

            }
        }
    }
    test("Counts matrix - RPM - Project matrix") {
        when {

            process {
                """
                input[0] = Channel.of([
                    [id:'TEST', species: 'Arabidopsis thaliana', project: 'TEST'],
                    [
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE1.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE2.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE3.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE4.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE5.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE6.rpm.tsv', checkIfExists: true)
                    ],
                    file(params.modules_testdata_base_path + 'modules/test_metadata.tsv', checkIfExists: true),
                    [1]
                ])
                input[1] = 'rpm'
                input[2] = true
                """
            }
        }
        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.matrix.get(0).get(1).get(0)) ==~ /.*\.rpm\.tsv/ }

                // Use snapshots to verify
                { assert snapshot(process.out.matrix).match() }

            }
        }
    }

    test("Counts matrix - Raw counts - Only subprojects") {
        when {

            process {
                """
                input[0] = Channel.of([
                    [id:'TEST', species: 'Arabidopsis thaliana', project: 'TEST'],
                    [
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE1.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE2.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE3.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE4.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE5.raw.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE6.raw.tsv', checkIfExists: true)
                    ],
                    file(params.modules_testdata_base_path + 'modules/test_metadata.tsv', checkIfExists: true),
                    [1]
                ])
                input[1] = 'raw'
                input[2] = false
                """
            }
        }

        then {
            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.matrix.get(0).get(1)) ==~ /.*\.raw\.tsv/ }

                // Use snapshots to verify
                { assert snapshot(process.out.matrix).match() }

            }
        }
    }
    test("Counts matrix - RPM - Only subprojects") {
        when {

            process {
                """
                input[0] = Channel.of([
                    [id:'TEST', species: 'Arabidopsis thaliana', project: 'TEST'],
                    [
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE1.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE2.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE3.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE4.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE5.rpm.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'modules/counts_matrix/SAMPLE6.rpm.tsv', checkIfExists: true)
                    ],
                    file(params.modules_testdata_base_path + 'modules/test_metadata.tsv', checkIfExists: true),
                    [1]
                ])
                input[1] = 'rpm'
                input[2] = false
                """
            }
        }
        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.matrix.get(0).get(1)) ==~ /.*\.rpm\.tsv/ }

                // Use snapshots to verify
                { assert snapshot(process.out.matrix).match() }

            }
        }
    }
}

