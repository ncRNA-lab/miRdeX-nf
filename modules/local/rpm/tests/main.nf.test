nextflow_process {

    name "Test Process RPM"
    script "../main.nf"
    process "RPM"

    test("RPM") {

        when {
            process {
                """
                input[0] = [   
                    [id: 'SAMPLE1', species: 'Arabidopsis thaliana', project: 'TEST_1'], 
                    file(params.modules_testdata_base_path + 'modules/rpm/SAMPLE1.raw.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert path(process.out.rpm.get(0).get(1)) ==~ /.*\.rpm\.tsv/ }

                // Use snapshots to verify
                { assert snapshot(process.out.rpm).match() }

            }
        }
    }
}
