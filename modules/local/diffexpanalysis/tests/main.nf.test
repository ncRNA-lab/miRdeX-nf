nextflow_process {

    name "Test Process DIFFEXPANALYSIS"
    script "../main.nf"
    process "DIFFEXPANALYSIS"

    test("Differential expression analysis - 1 Factor - Wald") {

        when {

            process {
                """
                input[0] = Channel.of([
                    [id:'TEST_1', group_id: 1, metadata: file(params.modules_testdata_base_path + 'modules/dea/test_metadata.tsv', checkIfExists: true)],
                    file(params.modules_testdata_base_path + 'modules/dea/TEST_1.counts.tsv', checkIfExists: true)
                ])
                input[1] = 0.05
                input[2] = 5
                input[3] = 3
                """
            }
        }

        then {

            assertAll{

                // Verify that the process has been successfully executed.
                { assert process.success }

                // Verify that the necessary output files are generated.
                { assert process.out.raw.get(0).get(1) ==~ /.*\.dea_raw\.tsv/ }
                { assert process.out.sig.get(0).get(1) ==~ /.*\.dea_sig\.tsv/ }
                { assert process.out.easum.get(0) ==~ /.*TEST_1\.ea_summary\.tsv/ }
                { assert process.out.deasum.get(0) ==~ /.*TEST_1\.dea_summary\.tsv/ }

                // Use snapshots to verify
                {
                    assert snapshot(
                        process.out.raw,
                        process.out.sig,
                        process.out.easum,
                        process.out.deasum
                    ).match() 
                }
            }
        }
    }
